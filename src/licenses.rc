#include <windows.h>
500 DIALOGEX 0, 0, 392, 342
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Game credits and license"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Optional credits and terms for your game ROM and its assets.", -1, 12, 10, 368, 12
    LTEXT "Player and third-party license notices are kept separately.", -1, 12, 25, 368, 12
    LTEXT "Author / studio", -1, 12, 49, 95, 12
    EDITTEXT 501, 112, 46, 268, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Copyright notice", -1, 12, 73, 95, 12
    EDITTEXT 502, 112, 70, 268, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "License name", -1, 12, 97, 95, 12
    EDITTEXT 503, 112, 94, 268, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "License text / terms", -1, 12, 124, 220, 12
    PUSHBUTTON "Import UTF-8 text...", 505, 266, 117, 114, 21
    EDITTEXT 504, 12, 144, 368, 134, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT "", 506, 12, 284, 368, 24
    DEFPUSHBUTTON "Apply", IDOK, 220, 312, 76, 22
    PUSHBUTTON "Cancel", IDCANCEL, 304, 312, 76, 22
END

520 DIALOGEX 0, 0, 392, 316
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Credits and licenses"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Game content and player software have separate license notices.", -1, 12, 10, 368, 14
    COMBOBOX 521, 12, 30, 368, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", 522, 12, 56, 368, 25
    EDITTEXT 523, 12, 86, 368, 186, ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Close", IDOK, 304, 284, 76, 22
END
